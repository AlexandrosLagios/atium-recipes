# Copy to .env on the VPS and fill in. Never commit .env.
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# The one id that may run /allow, /deny and /allowed. It must also appear
# in TELEGRAM_ALLOWED_USER_IDS, or the gate drops its own owner.
TELEGRAM_OWNER_ID=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://recipebot.atiumaddict.com/oauth/callback
OAUTH_CALLBACK_PORT=8080
DB_PATH=/data/recipebot.db

# Which model provider the bot runs on: gemini or anthropic. Defaults to
# gemini. Set only the key for the provider you choose; the other is ignored.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional. Override the two model ids to change a model without a code
# change. Empty means the provider's defaults: gemini-3.1-flash-lite and
# gemini-3.7-flash, or claude-haiku-4-5 and claude-sonnet-5.
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
